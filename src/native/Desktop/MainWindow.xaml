<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Tag="preview" Background="#F6F3EC">
 <Grid.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#29271F"/><Setter Property="FontSize" Value="14"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="0,3,7,7"/><Setter Property="Background" Value="#EEE9DF"/><Setter Property="Foreground" Value="#30291D"/><Setter Property="BorderBrush" Value="#D9D1C1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="9" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A55B00"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,0,0,15"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,6,0,10"/><Setter Property="Foreground" Value="#403A2E"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F2EEE6"/><Setter Property="Foreground" Value="#716A5C"/><Setter Property="Padding" Value="12"/><Setter Property="BorderThickness" Value="0"/></Style>
 </Grid.Resources>
 <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Background="#24251F" Padding="22,28">
  <DockPanel LastChildFill="True">
   <StackPanel DockPanel.Dock="Top">
    <Image Source="pack://application:,,,/LectureLens;component/assets/logomark.png" Width="78" Height="78" HorizontalAlignment="Left"/>
    <TextBlock Text="{DynamicResource brand}" FontSize="24" FontWeight="Bold" Foreground="#FFF8E9"/>
    <TextBlock Text="{DynamicResource localLabel}" FontSize="10" Foreground="#ACA99A" Margin="0,0,0,35"/>
    <Border Background="#3B3C30" CornerRadius="8" Padding="14"><TextBlock Text="{DynamicResource library}" Foreground="#FFD16D" FontWeight="SemiBold" Margin="0"/></Border>
    <Button x:Name="OpenFolder" Content="{DynamicResource folder}" Margin="0,14,0,0" Background="#24251F" Foreground="#D3D0C3" BorderBrush="#45473A"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom">
    <TextBlock Text="{DynamicResource privacyLabel}" Foreground="#B2B7A1" FontSize="12"/>
    <Button x:Name="KeySetup" Content="{DynamicResource keySetup}" Background="#34362C" Foreground="#ECE8DD" BorderBrush="#45473A"/>
    <Button x:Name="ExtensionFolder" Content="{DynamicResource extensionFolder}" Background="#FFC348" BorderBrush="#FFC348" FontSize="11" Padding="7,12"/>
   </StackPanel>
   <Grid/>
  </DockPanel>
 </Border>
 <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="30,26">
   <TextBlock Text="{DynamicResource heading}" FontSize="30" FontWeight="Bold"/>
   <TextBlock Text="{DynamicResource subtitle}" Foreground="#7E7769" Margin="0,0,0,22"/>
   <Border CornerRadius="18" Padding="25" Margin="0,0,0,26">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFC247"/><GradientStop Color="#F5A539" Offset="1"/></LinearGradientBrush></Border.Background>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource setupCaption}" FontSize="10" FontWeight="Bold" Foreground="#765019"/><TextBlock Text="{DynamicResource setupTitle}" FontSize="26" FontWeight="SemiBold" MaxWidth="430" HorizontalAlignment="Left"/><TextBlock Text="{DynamicResource nextBody}" FontSize="12" Foreground="#61451F" MaxWidth="440" HorizontalAlignment="Left"/></StackPanel>
     <Border Grid.Column="1" Background="#FFF9E9" CornerRadius="5" Padding="16" Margin="20,0,5,0" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform Angle="6"/></Border.RenderTransform><StackPanel><TextBlock Text="LECTURELENS" FontSize="9" FontWeight="Bold" Foreground="#A77313"/><TextBlock Text="{DynamicResource pdfPreviewTitle}" FontSize="22" FontWeight="Bold"/><Rectangle Height="4" Fill="#F4B934" Margin="0,5,0,10"/><TextBlock Text="{DynamicResource pdfPreviewBody}" FontSize="10" Foreground="#8B8069"/></StackPanel></Border>
    </Grid>
   </Border>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="{DynamicResource library}" FontSize="23" FontWeight="SemiBold"/>
     <TextBlock Text="{DynamicResource libraryHint}" FontSize="12" Foreground="#7E7769"/>
     <DataGrid x:Name="Sessions" Height="225" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" RowHeight="44" GridLinesVisibility="None" Background="#FFFCF6" RowBackground="#FFFCF6" AlternatingRowBackground="#F7F2E8" BorderBrush="#E1DACD">
      <DataGrid.Columns><DataGridTextColumn Header="{DynamicResource created}" Binding="{Binding CreatedAt}" Width="*"/><DataGridTextColumn Header="{DynamicResource state}" Binding="{Binding State}" Width="100"/></DataGrid.Columns>
     </DataGrid>
     <WrapPanel Margin="0,10,0,0"><Button x:Name="ViewSlides" Content="{DynamicResource viewSlides}" Background="#FFD477"/><Button x:Name="Refresh" Content="{DynamicResource refresh}"/><Button x:Name="Recover" Content="{DynamicResource recover}"/><Button x:Name="Stop" Content="{DynamicResource stop}"/><Button x:Name="Delete" Content="{DynamicResource delete}" Foreground="#9B4230"/></WrapPanel>
     <TextBlock Text="{DynamicResource scope}" FontSize="12" Foreground="#7C7566" Margin="0,14,0,10"/>
     <Border Background="#EDE9DF" CornerRadius="9" Padding="14"><TextBlock x:Name="SessionMessage" Foreground="#654A1D" Margin="0" FontSize="12"/></Border>
    </StackPanel>
    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E7DFD1" BorderThickness="1" CornerRadius="16" Padding="22">
     <StackPanel>
      <TextBlock Text="{DynamicResource notesTitle}" FontSize="24" FontWeight="Bold"/>
      <TextBlock Text="{DynamicResource notesHint}" FontSize="12" Foreground="#8C806A"/>
      <Button x:Name="ImportTranscript" Content="{DynamicResource importTranscript}"/>
      <TextBlock x:Name="TranscriptStatus" FontSize="11" Foreground="#877C68"/>
      <TextBlock Text="{DynamicResource detailLabel}" FontSize="12" FontWeight="SemiBold"/><ComboBox x:Name="Detail"/>
      <TextBlock Text="{DynamicResource languageLabel}" FontSize="12" FontWeight="SemiBold"/><ComboBox x:Name="PdfLanguage"/>
      <CheckBox x:Name="IncludeSlides" IsChecked="True"><TextBlock Text="{DynamicResource includeSlides}" Margin="0" FontSize="12"/></CheckBox>
      <TextBlock Text="{DynamicResource includeSlidesHint}" FontSize="11" Foreground="#877C68"/>
      <CheckBox x:Name="KeepRaw"><TextBlock Text="{DynamicResource retention}" Margin="0" FontSize="11"/></CheckBox>
      <CheckBox x:Name="CloudConsent"><TextBlock Text="{DynamicResource cloudConsent}" Margin="0" FontSize="11"/></CheckBox>
      <Button x:Name="GeneratePdf" Content="{DynamicResource generatePdf}" Background="#292D24" Foreground="#FFE3A2" Padding="12,15"/>
      <WrapPanel><Button x:Name="SavePreferences" Content="{DynamicResource savePreferences}" FontSize="11"/><Button x:Name="CancelGeneration" Content="{DynamicResource cancelGeneration}" FontSize="11"/></WrapPanel>
     </StackPanel>
    </Border>
   </Grid>
  </StackPanel>
 </ScrollViewer>
</Grid>
