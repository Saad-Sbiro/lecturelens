<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Tag="preview" Background="#141311">
  <Grid.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FAF7F0"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,11"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#FAF7F0"/><Setter Property="Background" Value="#2C261D"/>
      <Setter Property="BorderBrush" Value="#55452C"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Margin" Value="0,4,10,8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#FFD568"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#2C261D"/><Setter Property="Foreground" Value="#BEB6A8"/><Setter Property="Padding" Value="14,12"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="Padding" Value="14,10"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
  </Grid.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="38,28" MaxWidth="1100">
      <DockPanel Margin="0,0,0,22"><Rectangle Width="48" Height="54" Margin="0,0,12,0"><Rectangle.Fill><ImageBrush ImageSource="pack://application:,,,/LectureLens;component/assets/logomark.png" Viewbox="0.25,0.20,0.5,0.59" ViewboxUnits="RelativeToBoundingBox" Stretch="Uniform"/></Rectangle.Fill></Rectangle><TextBlock Text="{DynamicResource brand}" FontSize="24" FontWeight="Bold" Foreground="#FAF7F0" Margin="0,10,0,0"/><TextBlock Text="{DynamicResource localLabel}" HorizontalAlignment="Right" Foreground="#C7BAA2" FontSize="11" Margin="0,8,0,0"/></DockPanel>
      <TextBlock Text="{DynamicResource heading}" FontSize="34" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBlock Text="{DynamicResource subtitle}" Foreground="#BEB6A8"/>
      <Border Background="#201C16" BorderBrush="#463A29" BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,8,0,20">
        <StackPanel>
          <TextBlock Text="{DynamicResource statusTitle}" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="{DynamicResource statusBody}" Foreground="#BEB6A8"/>
          <Button x:Name="ExtensionFolder" Content="{DynamicResource extensionFolder}" Background="#FFBC28" Foreground="#241600" BorderBrush="#FFBC28"/>
        </StackPanel>
      </Border>
      <DockPanel Margin="0,0,0,6"><Button x:Name="OpenFolder" DockPanel.Dock="Right" Content="{DynamicResource folder}" Margin="0"/><TextBlock Text="{DynamicResource sessions}" FontSize="22" FontWeight="SemiBold" Margin="0,7,0,0"/></DockPanel>
      <TextBlock Text="{DynamicResource sessionHelp}" Foreground="#BEB6A8" FontSize="12"/>
      <Grid>
      <DataGrid x:Name="Sessions" Height="185" IsReadOnly="True" AutoGenerateColumns="False" Foreground="#FAF7F0" Background="#201C16" RowBackground="#201C16" AlternatingRowBackground="#292219" BorderBrush="#463A29" GridLinesVisibility="None" HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="{DynamicResource created}" Binding="{Binding CreatedAt}" Width="*"/>
          <DataGridTextColumn Header="{DynamicResource state}" Binding="{Binding State}" Width="130"/>
          <DataGridTextColumn Header="{DynamicResource packets}" Binding="{Binding Chunks}" Width="90"/>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="{DynamicResource empty}" Foreground="#BEB6A8" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,30,20,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=Sessions}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid>
      <WrapPanel>
        <Button x:Name="Refresh" Content="{DynamicResource refresh}"/>
        <Button x:Name="Recover" Content="{DynamicResource recover}"/>
        <Button x:Name="ViewSlides" Content="{DynamicResource viewSlides}" Background="#FFBC28" Foreground="#241600" BorderBrush="#FFBC28"/>
        <Button x:Name="Stop" Content="{DynamicResource stop}"/>
        <Button x:Name="Delete" Content="{DynamicResource delete}" Foreground="#FFB2AC"/>
      </WrapPanel>
      <TextBlock x:Name="SessionMessage" Foreground="#FBBF24"/>
      <TextBlock Text="{DynamicResource nextBody}" Foreground="#BEB6A8" FontSize="12"/>
      <TextBlock Text="{DynamicResource scope}" Foreground="#B0A38D" FontSize="14"/>
    </StackPanel>
  </ScrollViewer>
</Grid>
